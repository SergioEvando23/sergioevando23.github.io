{
  "name": "Sérgio-costa-portfolio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src e2e next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest --exclude src/test/rules/**",
    "test:run": "vitest run --exclude src/test/rules/**",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,database \"vitest run src/test/rules\"",
    "validate:i18n": "tsx scripts/validate-dicionario.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"e2e/**/*.{ts,tsx}\" \"*.{js,mjs,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"e2e/**/*.{ts,tsx}\" \"*.{js,mjs,ts,json,md}\"",
    "validate": "npm run validate:i18n && npm run typecheck && npm run lint && npm run test:run && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "clsx": "latest",
    "firebase": "^12.19.0",
    "next": "^16.3.5",
    "next-themes": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "latest",
    "firebase-tools": "^15.30.1",
    "jsdom": "^30.1.0",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vitest": "latest"
  }
}
