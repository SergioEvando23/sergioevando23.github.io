rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'sergioevandocosta@gmail.com';
    }

    function isAdmin() {
      return isAllowedEmail()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function validProjectId(projectId) {
      return projectId.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    match /study-projects/{projectId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validProjectId(projectId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isAdmin() && validProjectId(projectId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
